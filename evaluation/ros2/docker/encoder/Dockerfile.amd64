# FROM osrf/ros:humble-desktop-full
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

# Set noninteractive frontend
ENV DEBIAN_FRONTEND=noninteractive

# Add ROS 2 repo
RUN apt-get update && apt-get install -y \
    locales \
    curl \
    gnupg \
    lsb-release \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

ENV LANG=en_US.UTF-8

# Setup sources
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key | apt-key add - && \
    sh -c 'echo "deb [arch=amd64] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros2-latest.list'

# Install ROS 2 Humble
RUN apt-get update && apt-get install -y \
    ros-humble-desktop \
    python3-colcon-common-extensions \
    ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# Source ROS 2 environment
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc


RUN apt-get update && apt-get install -y git vim python3-pip python3-dev cmake build-essential wget unzip
RUN wget https://github.com/bazelbuild/bazelisk/releases/download/v1.18.0/bazelisk-linux-amd64 -O /usr/local/bin/bazel && chmod +x /usr/local/bin/bazel

RUN wget https://download.pytorch.org/libtorch/nightly/cu128/libtorch-cxx11-abi-shared-with-deps-latest.zip \
    && unzip libtorch-cxx11-abi-shared-with-deps-latest.zip -d /opt \
    && rm libtorch-cxx11-abi-shared-with-deps-latest.zip

RUN mkdir -p /opt/inference/src
WORKDIR /opt/inference

# # Clone TensorRT repository
RUN git clone https://github.com/pytorch/TensorRT.git --branch main
WORKDIR /opt/inference/TensorRT


# # Build TensorRT
RUN bazel build //:libtorchtrt -c opt
RUN mkdir -p /opt/libtorchtrt/include /opt/libtorchtrt/lib &&     cp -r cpp/include/torch_tensorrt /opt/libtorchtrt/include/ &&     cp bazel-bin/cpp/lib/* /opt/libtorchtrt/lib/

RUN cp /root/.cache/bazel/_bazel_root/0555b06411bdc5a650e0565d126ef44b/execroot/_main/bazel-out/k8-opt/bin/_solib_k8/_U_A_A+_Urepo_Urules3+libtorch_S_S_Cc10___Ulib/libc10.so /opt/libtorch/lib/.


ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/lib/python3.8/dist-packages/torch/lib"
ENV LD_LIBRARY_PATH=/root/.cache/bazel/_bazel_root/0555b06411bdc5a650e0565d126ef44b/external/+_repo_rules3+tensorrt/targets/x86_64-linux-gnu/lib:$LD_LIBRARY_PATH
ENV Torch_DIR=/opt/libtorch/share/cmake/Torch
ENV LD_LIBRARY_PATH=/opt/libtorchtrt/lib:$LD_LIBRARY_PATH
ENV LD_LIBRARY_PATH=/opt/libtorch/lib:$LD_LIBRARY_PATH

###
RUN pip3 install scipy

RUN mkdir -p /opt/robomaster/src
# COPY src /opt/robomaster/src
COPY configs/cyclone_dds_profile_base.xml /opt/robomaster


WORKDIR /opt/robomaster

RUN . /opt/ros/humble/setup.sh && colcon build --symlink-install --packages-select sensing_msgs sensing_cpp

ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=/opt/robomaster/cyclone_dds_profile_base.xml
